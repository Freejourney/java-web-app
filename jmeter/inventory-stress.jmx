          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Expect HTTP 204" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">if (prev.getResponseCode() != &apos;204&apos;) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&quot;Expected HTTP 204, got ${prev.getResponseCode()}&quot;) }</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
